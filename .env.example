# ─── App ────────────────────────────────────────────────────────────────
# Public base URL (no trailing slash). On Vercel set this to your production domain.
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Signs session cookies + OAuth state.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# 32 random bytes, base64. AES-256-GCM key for encrypting third-party tokens at rest.
# Rotating it: add the new key as TOKEN_ENCRYPTION_KEY and move the old one to
# TOKEN_ENCRYPTION_KEY_PREVIOUS; old tokens still decrypt and get re-encrypted on refresh.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Public contact addresses used on the privacy policy / terms / data deletion pages.
SUPPORT_EMAIL=support@example.com
PRIVACY_EMAIL=privacy@example.com

# ─── Database (Postgres — Neon via the Vercel Marketplace works well) ──
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Direct (non-pooled) URL for migrations. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ─── Meta (Facebook Login for Business + Instagram Graph API) ──────────
META_APP_ID=
META_APP_SECRET=
# Configuration ID from Facebook Login for Business → Configurations.
# If empty, the classic `scope=` login dialog is used instead (fine for dev).
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
# Any random string; paste the same value into the Webhooks "Verify token" field.
META_WEBHOOK_VERIFY_TOKEN=

# ─── OpenAI (reply drafting) ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ─── Vercel Cron ───────────────────────────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes.
CRON_SECRET=

# Allow creating accounts via /signup (set to "false" to close signups).
SIGNUPS_OPEN=true
